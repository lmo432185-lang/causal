  "stationary_initial": true,
  "variance_matching": "each physical X normalized by its theoretical stationary std at generation, X variance1; normalization not supplied to fitter; measurement noise independent",
  "learner": "observations only, no true YZ/graph/parameters; unit latent innovation covariance is a coordinate/scale gauge, not truth values",
  "fit": "stationary constrained generalized EM, closed-form/box-constrained transition blocks; stationary P0 refreshed; observed-likelihood rollback safeguard; warmup covariance converged1e-12 then fast stable recurrences",
  "topologies": [
    "G1 parallel",
    "G2 Y->Z->X",
    "G3 mixed",
    "G4 Z->Y->X"
  ],
  "initializations": 4,
  "max_iterations": 40,
  "convergence": "per-observation likelihood change<3e-5 after8iterations",
  "delay_search": "G3 2initializations each d1,d2; G1/G2/single4 each; pure-cascade delay has same stationary X law, fit d1 canonical; G4 exact mirrored four G2 EM trajectories, separately checked",
  "bounds": {
    "AR": [
      0,
      0.98
    ],
    "coupling": [
      0,
      3
    ],
    "qx_R": [
      1e-05,
      5
    ]
  },
  "selection": "per-candidate choose initialization/delay by validation LL-0.5*k*log(nval); no labels; all hyperparameters fixed",
  "confidence": "per-test trajectory softmax(conditional loglik-0.5*k*log(900)); uncalibrated score, not Bayesian true-graph probability",
  "rejection": "score>=.95 plus validation compatibility and estimated-law equivalence closure audit; required fitted path coefficient<1e-3 is boundary-ambiguous; separately retain naive-score decision",
  "equivalence_audit": "known permutation of hidden names; fitted stationary spectral identities mapping parallel/chain/mixed into other allowed candidate topologies; no truth used",
  "baseline": "single hidden state, same4 initializations",
  "oracle": "only after global X-only decisions frozen; Y,Z observed; separate structural reference",
  "alignment": "only after all X-only predictions and thresholds frozen, fit joint linear map on validation trueYZ then evaluate test; alignment never changes graph scores",
  "statistics": "independent trajectories and3 data seeds; no timepoint IID; report optimizer caps and failures, no calibrating temperature from labels",
  "not_claimed": [
    "arbitrary hidden causal discovery",
    "globally converged MLE for every start",
    "calibrated graph posterior",
    "dynamic failure warning"
  ]
